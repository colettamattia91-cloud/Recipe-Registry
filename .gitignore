/INTERNAL_ROADMAP.md
/CODEBASE_ANALYSIS.local.md
/RecipeRegistry-*.zip
/.vscode/
/build/
/debug.log
# Python bytecode from the metadata generator — recompiled by Python on
# every run, no value in source control.
__pycache__/
*.pyc

# Stray files from mis-escaped Windows paths in shell pastes (e.g.
# "C:Tempdiff_core.txt" — a shell that interpreted "C:\Temp\…" as a
# literal filename in the working directory).
/C:*.txt
# The cmangos world DB the trainer importer downloads: 300MB of somebody
# else's reconstruction, and only an input to the fetch. What gets committed
# is snapshots/*/trainers.json, which is a few hundred lines.
tools/recipe-metadata/snapshots/*/.cmangos/
