<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- LibStub (must load first) -->
    <Script file="LibStub\LibStub.lua"/>

    <!-- CallbackHandler (required by most Ace libs) -->
    <Include file="CallbackHandler-1.0\CallbackHandler-1.0.xml"/>

    <!-- Shared launcher/minimap libraries -->
    <Script file="LibDataBroker-1.1\LibDataBroker-1.1.lua"/>
    <Include file="LibDBIcon-1.0\lib.xml"/>

    <!-- Ace3 modules. Non ci sono AceGUI-3.0 ne' AceHook-3.0: nessuna riga di
         questo addon le chiedeva, ne' direttamente ne' tramite un'altra
         libreria. La UI costruisce i suoi frame a mano e gli hook sono
         HookScript di Blizzard. Stesso discorso per LibSerialize: il codec del
         sync usa AceSerializer. Verificato il 2026-09-18. -->
    <Include file="AceAddon-3.0\AceAddon-3.0.xml"/>
    <Include file="AceEvent-3.0\AceEvent-3.0.xml"/>
    <Include file="AceTimer-3.0\AceTimer-3.0.xml"/>
    <Include file="AceBucket-3.0\AceBucket-3.0.xml"/>
    <Include file="AceDB-3.0\AceDB-3.0.xml"/>
    <Include file="AceConsole-3.0\AceConsole-3.0.xml"/>
    <Include file="AceComm-3.0\AceComm-3.0.xml"/>
    <Include file="AceSerializer-3.0\AceSerializer-3.0.xml"/>

    <!-- LibDeflate -->
    <Include file="LibDeflate\lib.xml"/>

</Ui>
